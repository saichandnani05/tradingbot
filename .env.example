# ── Copy this file to .env and fill in your values ───────────────────────────
# Never commit .env to git!

# Trading mode: true = paper (no real money), false = live Angel One orders
PAPER_MODE=true

# Starting virtual wallet balance (only used in paper mode)
STARTING_WALLET=100000

# Max lots per order (controls position size)
MAX_LOTS_PER_ORDER=2

# Flask secret key — change this to a long random string in production
FLASK_SECRET=change-me-to-something-random-in-production

# ── Angel One SmartAPI (only needed if PAPER_MODE=false) ─────────────────────
# Get these from https://smartapi.angelone.in/
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_MPIN=
ANGEL_TOTP_SECRET=
